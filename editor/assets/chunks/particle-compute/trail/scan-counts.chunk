precision highp float;
#include <particle-compute/trail/declarations>

shared uint sums[64];

void main() {
    uint h = ccParticleInvocationIndex(), lane = gl_LocalInvocationID.x;
    uint value = 0u;
    if (h < limits.x) {
        value = control[metaBase(h) + PARTICLE_TRAIL_META_INDEX_COUNT];
    }
    sums[lane] = value;
    barrier();

    for (uint distance = 1u; distance < 64u; distance *= 2u) {
        uint addend = 0u;
        if (lane >= distance) addend = sums[lane - distance];
        barrier();
        sums[lane] += addend;
        barrier();
    }

    if (h < limits.x) {
        control[metaBase(h) + PARTICLE_TRAIL_META_INDEX_PREFIX] = sums[lane] - value;
    }
    if (lane == 63u && ccParticleGroupIndex() < limits.z) {
        control[PARTICLE_TRAIL_CTRL_HEADER_WORDS + ccParticleGroupIndex()] = sums[lane];
    }
}
