precision highp float;
#include <particle-compute/trail/declarations>

void main() {
    uint i = ccParticleInvocationIndex();
    if (i >= min(counters[PARTICLE_SIM_CTRL_LIVE_COUNT], limits.x)) return;
    uint h = counters[counters[PARTICLE_SIM_CTRL_ALIVE_OFFSET] + i];
    if (h < limits.x) {
        control[mapBase() + h] = h;
    }
}
