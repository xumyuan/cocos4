precision highp float;
#define CC_TRAIL_USE_CURVES 1
#include <particle-compute/trail/declarations>

void emitPair(uint vertex, vec3 position, vec3 tangent, float width, uint direction, float u, uint packedColor) {
    for (uint side = 0u; side < 2u; ++side) {
        uint at = (vertex + side) * PARTICLE_TRAIL_VERTEX_WORDS;
        vertices[at + PARTICLE_TRAIL_VERTEX_POSITION_X] = floatBitsToUint(position.x);
        vertices[at + PARTICLE_TRAIL_VERTEX_POSITION_Y] = floatBitsToUint(position.y);
        vertices[at + PARTICLE_TRAIL_VERTEX_POSITION_Z] = floatBitsToUint(position.z);
        vertices[at + PARTICLE_TRAIL_VERTEX_DIRECTION] = floatBitsToUint(float(side == 0u ? direction : 1u - direction));
        vertices[at + PARTICLE_TRAIL_VERTEX_WIDTH] = floatBitsToUint(width);
        vertices[at + PARTICLE_TRAIL_VERTEX_U] = floatBitsToUint(u);
        vertices[at + PARTICLE_TRAIL_VERTEX_V] = floatBitsToUint(float(side));
        vertices[at + PARTICLE_TRAIL_VERTEX_TANGENT_X] = floatBitsToUint(tangent.x);
        vertices[at + PARTICLE_TRAIL_VERTEX_TANGENT_Y] = floatBitsToUint(tangent.y);
        vertices[at + PARTICLE_TRAIL_VERTEX_TANGENT_Z] = floatBitsToUint(tangent.z);
        vertices[at + PARTICLE_TRAIL_VERTEX_COLOR] = packedColor;
    }
}
void main() {
    uint h = ccParticleInvocationIndex();
    if (h >= limits.x) return;
    uint m = metaBase(h);
    uint edges = control[m + PARTICLE_TRAIL_META_INDEX_COUNT] / 6u;
    if (edges == 0u) return;
    uint head = control[m + PARTICLE_TRAIL_META_HEAD];
    uint count = control[m + PARTICLE_TRAIL_META_COUNT];
    uint index = control[mapBase() + h];
    ParticleState p = particles[index];
    uint vertex = h * (limits.y + 1u) * 2u;
    uint pairCount = edges == count ? count + 1u : count;
    for (uint j = 0u; j < pairCount; ++j) {
        vec3 pos;
        vec3 tanVec;
        float width;
        uint dir;
        float u;
        uint randKey;
        vec4 baseColor;
        if (j < count) {
            TrailPoint point = points[pointAt(h, head, j)];
            pos = point.positionAge.xyz;
            tanVec = point.tangentWidth.xyz;
            width = point.tangentWidth.w;
            dir = point.colorDirection.y;
            u = 1.0 - float(j) / float(count);
            randKey = p.identity.x ^ j ^ uint(tick.w);
            baseColor = unpackColor(point.colorDirection.x);
        } else {
            TrailPoint last = points[pointAt(h, head, count - 1u)];
            pos = trailPosition(p);
            tanVec = pos - last.positionAge.xyz;
            if (count > 2u) {
                tanVec = safeNormalize(tanVec);
            }
            width = pointWidth(p, 0.0);
            dir = reverseDirection(tanVec, last);
            u = 0.0;
            randKey = p.identity.x ^ uint(tick.w);
            baseColor = p.color;
        }
        vec4 tint = ccColor(PARTICLE_TRAIL_MOD_COLOR_OVER_TRAIL, u, 1.0, ccParticleRandomPair(randKey));
        emitPair(vertex + j * 2u, pos, tanVec, width, dir, u, packColor(baseColor * tint));
    }
    uint base = control[m + PARTICLE_TRAIL_META_INDEX_PREFIX] + control[PARTICLE_TRAIL_CTRL_HEADER_WORDS + ccParticleGroupIndex()];
    for (uint j = 0u; j < edges; ++j) {
        uint v = vertex + j * 2u, at = base + j * 6u;
        indices[at] = v;
        indices[at + 1u] = v + 1u;
        indices[at + 2u] = v + 2u;
        indices[at + 3u] = v + 2u;
        indices[at + 4u] = v + 1u;
        indices[at + 5u] = v + 3u;
    }
}
