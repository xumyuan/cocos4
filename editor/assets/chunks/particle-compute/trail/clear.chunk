precision highp float;
#include <particle-compute/trail/declarations>

void main() {
    uint h = ccParticleInvocationIndex();
    if (h >= limits.x) return;
    uint m = metaBase(h);
    uint generation = control[m], phase = control[m + 1u];
    for (uint j = 0u; j < 8u; ++j)
        control[m + j] = 0u;
    if (tick.z < 0.0) {
        // Disabling the trail clears its Map, not Particle.lastLoop/trailDelay.
        control[m] = generation;
        control[m + 1u] = min(phase, 3u);
    }
    control[mapBase() + h] = 0xffffffffu;
    if (h < limits.z) control[8u + h] = 0u;
    if (h == 0u) {
        for (uint j = 0u; j < 8u; ++j)
            control[j] = 0u;
        control[1] = 1u;
    }
}
