precision highp float;
#include <particle-compute/simulation/declarations>

shared uint values[64];
void main() {
    uint i = ccParticleInvocationIndex(), l = gl_LocalInvocationID.x, group = ccParticleGroupIndex();
    uint a = 0u;
    if (i < counts.x) a = control[scratch.x + i];
    values[l] = a;
    barrier();
    for (uint offset = 1u; offset < 64u; offset *= 2u) {
        uint b = 0u;
        if (l >= offset) b = values[l - offset];
        barrier();
        values[l] += b;
        barrier();
    }
    if (i < counts.x) control[scratch.y + i] = values[l] - a;
    if (l == 63u && group < counts.w) control[scratch.z + group] = values[l];
}
