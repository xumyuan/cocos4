precision highp float;
#include <particle-compute/simulation/declarations>

void main() {
    if (ccParticleInvocationIndex() != 0u) return;
    uint accepted = min(counts.y, counts.x - control[0]);
    control[1] = accepted;
    control[2] = control[0] + accepted;
    control[3] = 0u;
    control[8] = control[4];
    control[9] = control[4] - accepted;
    float total = uintBitsToFloat(control[10]), last = uintBitsToFloat(control[11]);
    for (uint batch = 0u; batch < counts.z; batch++) {
        uint begin = birthWords[batch * 4u], end = birthWords[batch * 4u + 1u], b = birthWords[batch * 4u + 2u];
        float angle = 0.0;
        if (begin < accepted && end > begin && birthRead(b, 2u) > 0.5) {
            float now = birthRead(b, 19u);
            int mode = int(birthRead(b, 10u)), shape = int(birthRead(b, 3u));
            if ((shape == 1 || shape == 2) && mode != 0) {
                total += 6.28318530718 * birthRead(b, 52u) * (now - last);
                angle = total;
                float arc = birthRead(b, 9u), spread = birthRead(b, 51u);
                if (arc > 0.0) {
                    if (spread != 0.0) angle = floor(angle / (arc * spread)) * arc * spread;
                    angle = mode == 2 ? arc - abs(mod(angle, 2.0 * arc) - arc) : mod(angle, arc);
                } else
                    angle = 0.0;
            }
            last = now;
        }
        control[identityOffsets.z + batch] = floatBitsToUint(angle);
    }
    control[10] = floatBitsToUint(total);
    control[11] = floatBitsToUint(last);
}
