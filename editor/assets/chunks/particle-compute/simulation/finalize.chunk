precision highp float;
#include <particle-compute/simulation/declarations>

void main() {
    if (ccParticleInvocationIndex() != 0u) return;
    control[PARTICLE_SIM_CTRL_FREE_COUNT] = control[PARTICLE_SIM_CTRL_FREE_TOP_AFTER] + control[PARTICLE_SIM_CTRL_ACTIVE_COUNT] - control[PARTICLE_SIM_CTRL_SURVIVOR_COUNT];
    control[PARTICLE_SIM_CTRL_EMITTED_TOTAL] += control[PARTICLE_SIM_CTRL_ACCEPTED];
    control[PARTICLE_SIM_CTRL_LIVE_COUNT] = control[PARTICLE_SIM_CTRL_SURVIVOR_COUNT];
    uint previous = control[PARTICLE_SIM_CTRL_ALIVE_OFFSET];
    control[PARTICLE_SIM_CTRL_ALIVE_OFFSET] = control[PARTICLE_SIM_CTRL_NEXT_ALIVE_OFFSET];
    control[PARTICLE_SIM_CTRL_NEXT_ALIVE_OFFSET] = previous;
}
