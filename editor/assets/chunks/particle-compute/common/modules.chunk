#pragma define-meta CC_PARTICLE_HAS_NOISE
#include <particle-compute/common/curves>

// Keep in sync with ParticleModuleRandSeed in cocos/particle/enum.ts.
const uint PARTICLE_LIMIT_RANDOM_SEED_OFFSET = 23541u;
const uint PARTICLE_SIZE_RANDOM_SEED_OFFSET = 39825u;
const uint PARTICLE_TEXTURE_RANDOM_SEED_OFFSET = 90794u;
const uint PARTICLE_COLOR_RANDOM_SEED_OFFSET = 91041u;
const uint PARTICLE_FORCE_RANDOM_SEED_OFFSET = 212165u;
const uint PARTICLE_ROTATION_RANDOM_SEED_OFFSET = 125292u;
const uint PARTICLE_VELOCITY_X_RANDOM_SEED_OFFSET = 197866u;
const uint PARTICLE_VELOCITY_Y_RANDOM_SEED_OFFSET = 156497u;
const uint PARTICLE_VELOCITY_Z_RANDOM_SEED_OFFSET = 984136u;

float ccParticleScalars[PARTICLE_MODULE_SCALAR_COUNT];

float ccParticleCurve(uint field) {
    return ccParticleScalars[field - PARTICLE_MODULE_SCALAR_BASE];
}

void ccEvaluateParticleCurves(bool birth, float time, float initialRandom, uint seed) {
    uint flags = uint(ccParam(PARTICLE_MODULE_FLAGS));
    // A buffer-supplied bound keeps driver compilers from unrolling the full RealCurve evaluator per property.
    uint end = min(
        uint(ccParam(PARTICLE_MODULE_SCALAR_END)),
        birth ? PARTICLE_MODULE_BIRTH_SCALAR_END : PARTICLE_MODULE_UPDATE_SCALAR_END
    );
    for (uint field = birth ? PARTICLE_MODULE_BIRTH_SCALAR_BEGIN : PARTICLE_MODULE_UPDATE_SCALAR_BEGIN; field < end; ++field) {
        uint flag = 0u;
        uint randomSeed = seed;
        if (field == PARTICLE_MODULE_START_COLOR || field == PARTICLE_MODULE_COLOR) {
            continue;
        }
        if (!birth) {
            if (field >= PARTICLE_MODULE_SIZE && field <= PARTICLE_MODULE_SIZE_Z) {
                flag = PARTICLE_MODULE_FLAG_SIZE;
                randomSeed = seed + PARTICLE_SIZE_RANDOM_SEED_OFFSET;
            } else if (field >= PARTICLE_MODULE_FORCE_X && field <= PARTICLE_MODULE_FORCE_Z) {
                flag = PARTICLE_MODULE_FLAG_FORCE;
                randomSeed = seed + PARTICLE_FORCE_RANDOM_SEED_OFFSET;
            } else if (field >= PARTICLE_MODULE_VELOCITY_X && field <= PARTICLE_MODULE_SPEED) {
                flag = PARTICLE_MODULE_FLAG_VELOCITY;
                randomSeed = field == PARTICLE_MODULE_VELOCITY_X ? seed ^ PARTICLE_VELOCITY_X_RANDOM_SEED_OFFSET
                    : field == PARTICLE_MODULE_VELOCITY_Y ? seed ^ PARTICLE_VELOCITY_Y_RANDOM_SEED_OFFSET
                    : field == PARTICLE_MODULE_VELOCITY_Z ? seed ^ PARTICLE_VELOCITY_Z_RANDOM_SEED_OFFSET
                    : seed + PARTICLE_VELOCITY_X_RANDOM_SEED_OFFSET;
            } else if (field >= PARTICLE_MODULE_LIMIT && field <= PARTICLE_MODULE_LIMIT_Z) {
                flag = PARTICLE_MODULE_FLAG_LIMIT;
                randomSeed = seed + PARTICLE_LIMIT_RANDOM_SEED_OFFSET;
            } else if (field >= PARTICLE_MODULE_ROTATION_X && field <= PARTICLE_MODULE_ROTATION_Z) {
                flag = PARTICLE_MODULE_FLAG_ROTATION;
                randomSeed = seed + PARTICLE_ROTATION_RANDOM_SEED_OFFSET;
            } else if (field >= PARTICLE_MODULE_START_FRAME && field <= PARTICLE_MODULE_FRAME) {
                flag = PARTICLE_MODULE_FLAG_TEXTURE;
                randomSeed = seed + PARTICLE_TEXTURE_RANDOM_SEED_OFFSET;
            }
            if (flag != 0u && (flags & flag) == 0u) {
                continue;
            }
        }
        ccParticleScalars[field - PARTICLE_MODULE_SCALAR_BASE] = ccCurve(field, time, birth ? initialRandom : ccParticlePseudoRandom(randomSeed));
    }
}

vec4 ccQuaternionMultiply(vec4 a, vec4 b) {
    return vec4(a.w * b.xyz + b.w * a.xyz + cross(a.xyz, b.xyz), a.w * b.w - dot(a.xyz, b.xyz));
}

vec4 ccQuaternionFromEuler(vec3 radians) {
    vec3 s = sin(radians * 0.5);
    vec3 c = cos(radians * 0.5);
    // Cocos Quat.fromEuler: YZX order (not a generic XYZ replacement).
    return vec4(
        s.x * c.y * c.z + c.x * s.y * s.z,
        c.x * s.y * c.z + s.x * c.y * s.z,
        c.x * c.y * s.z - s.x * s.y * c.z,
        c.x * c.y * c.z - s.x * s.y * s.z
    );
}

vec3 ccRotateVector(vec4 quaternion, vec3 v) {
    // Vec3.transformQuat evaluates q*v*conjugate(q), including non-unit q.
    return dot(quaternion, quaternion) * v + 2.0 * cross(quaternion.xyz, cross(quaternion.xyz, v) + quaternion.w * v);
}

float ccInitialLifetime(float loopDelta, float randomRatio) {
    return ccParticleCurve(PARTICLE_MODULE_START_LIFE);
}

float ccInitialSpeed(float loopDelta, float randomRatio) {
    return ccParticleCurve(PARTICLE_MODULE_START_SPEED);
}

void ccInitializeParticleModules(inout ParticleState p, float loopDelta, float randomRatio) {
    uint seed = p.identity.x;
    uint mode = uint(ccParam(PARTICLE_MODULE_RENDER_MODE));
    float sx = ccParticleCurve(PARTICLE_MODULE_START_SIZE_X);
    p.startSize = vec4(sx, sx, 1.0, 0.0);
    if (ccParam(PARTICLE_MODULE_START_SIZE_3D) != 0.0) {
        p.startSize.xyz = vec3(sx, ccParticleCurve(PARTICLE_MODULE_START_SIZE_Y), ccParticleCurve(PARTICLE_MODULE_START_SIZE_Z));
    }
    p.size = vec4(p.startSize.xyz, 0.0);
    p.startColor = ccColor(PARTICLE_MODULE_START_COLOR, loopDelta, randomRatio, ccParticleRandomPair(seed ^ p.identity.y));
    p.color = p.startColor;
    vec3 startEuler = vec3(0.0, 0.0, ccParticleCurve(PARTICLE_MODULE_START_ROTATION_Z));
    if (ccParam(PARTICLE_MODULE_START_ROTATION_3D) != 0.0) {
        startEuler.xy = vec2(ccParticleCurve(PARTICLE_MODULE_START_ROTATION_X), ccParticleCurve(PARTICLE_MODULE_START_ROTATION_Y));
    }
    p.rotation = vec4(startEuler, 0.0);
    vec3 filtered = startEuler;
    if (mode == PARTICLE_RENDER_MODE_STRETCHED_BILLBOARD) {
        filtered = vec3(0.0);
    } else if (mode == PARTICLE_RENDER_MODE_HORIZONTAL_BILLBOARD || mode == PARTICLE_RENDER_MODE_VERTICAL_BILLBOARD) {
        filtered.xy = vec2(0.0);
    }
    p.startRotation = ccQuaternionFromEuler(filtered);
    p.deltaRotation = vec4(0.0, 0.0, 0.0, 1.0);
    p.renderVelocity = vec4(p.velocityLife.xyz, 0.0);
    // CPU Texture.init runs only when the module is enabled at birth. A fresh
    // Particle otherwise starts with row 0, even if disabled asset tilesY > 1.
    // When enabled, CPU still preselects a row even if randomRow is currently off.
    if ((uint(ccParam(PARTICLE_MODULE_FLAGS)) & PARTICLE_MODULE_FLAG_TEXTURE) != 0u) {
        p.startSize.w = floor(ccParticleRandom(seed ^ p.identity.y ^ PARTICLE_TEXTURE_RANDOM_SEED_OFFSET) * ccParam(PARTICLE_MODULE_TILES_Y));
    }
}

float ccDampen(float velocity, float limitValue, float dampen) {
    float magnitude = abs(velocity);
    if (magnitude > limitValue) {
        magnitude = max(limitValue, magnitude - magnitude * dampen);
    }
    return sign(velocity) * magnitude;
}

#if CC_PARTICLE_HAS_NOISE
int ccPerm(uint permBase, int i) {
    uint idx = uint(i) & 255u;
    uint pair = uint(ccParam(permBase + (idx >> 1u)));
    return int((pair >> ((idx & 1u) * 8u)) & 255u);
}

float ccNoiseGradient(int hash, vec3 p) {
    int h = hash & 15;
    float u = h < 8 ? p.x : p.y;
    float v = h < 4 ? p.y : ((h == 12 || h == 14) ? p.x : p.z);
    return ((h & 1) == 0 ? u : -u) + ((h & 2) == 0 ? v : -v);
}

float ccPerlin(uint permBase, vec3 point) {
    ivec3 cube = ivec3(floor(point)) & ivec3(255);
    vec3 p = fract(point);
    vec3 f = p * p * p * (p * (p * 6.0 - 15.0) + 10.0);
    int a = ccPerm(permBase, cube.x) + cube.y;
    int aa = ccPerm(permBase, a) + cube.z;
    int ab = ccPerm(permBase, a + 1) + cube.z;
    int b = ccPerm(permBase, cube.x + 1) + cube.y;
    int ba = ccPerm(permBase, b) + cube.z;
    int bb = ccPerm(permBase, b + 1) + cube.z;
    return mix(
        mix(
            mix(
                ccNoiseGradient(ccPerm(permBase, aa), p),
                ccNoiseGradient(ccPerm(permBase, ba), p - vec3(1.0, 0.0, 0.0)),
                f.x
            ),
            mix(
                ccNoiseGradient(ccPerm(permBase, ab), p - vec3(0.0, 1.0, 0.0)),
                ccNoiseGradient(ccPerm(permBase, bb), p - vec3(1.0, 1.0, 0.0)),
                f.x
            ),
            f.y
        ),
        mix(
            mix(
                ccNoiseGradient(ccPerm(permBase, aa + 1), p - vec3(0.0, 0.0, 1.0)),
                ccNoiseGradient(ccPerm(permBase, ba + 1), p - vec3(1.0, 0.0, 1.0)),
                f.x
            ),
            mix(
                ccNoiseGradient(ccPerm(permBase, ab + 1), p - vec3(0.0, 1.0, 1.0)),
                ccNoiseGradient(ccPerm(permBase, bb + 1), p - vec3(1.0, 1.0, 1.0)),
                f.x
            ),
            f.y
        ),
        f.z
    );
}

float ccOctaveNoise(uint permBase, vec3 point) {
    uint octaves = uint(ccParam(PARTICLE_MODULE_NOISE_OCTAVES));
    float frequency = ccParam(PARTICLE_MODULE_NOISE_FREQUENCY);
    float amplitude = 1.0;
    float range = 0.0;
    float sum = 0.0;
    for (uint i = 0u; i < octaves; ++i) {
        if (i > 0u) {
            amplitude *= ccParam(PARTICLE_MODULE_NOISE_MULTIPLIER);
            frequency *= ccParam(PARTICLE_MODULE_NOISE_SCALE);
        }
        range += amplitude;
        float sampleValue = ccPerlin(permBase, point * frequency);
        sum = i == 0u ? sampleValue : sum + sampleValue * amplitude;
    }
    return sum / range;
}
#endif

void ccApplyParticleModules(inout ParticleState p, float dt, float systemTime, uint tickId, vec3 gravity) {
    uint flags = uint(ccParam(PARTICLE_MODULE_FLAGS));
    uint seed = p.identity.x;
    uint renderMode = uint(ccParam(PARTICLE_MODULE_RENDER_MODE));
    float t = p.velocityLife.w > 0.0 ? 1.0 - p.positionLife.w / p.velocityLife.w : 0.0;
    ccEvaluateParticleCurves(false, t, 0.0, seed);
    p.velocityLife.xyz += gravity * ccParticleCurve(PARTICLE_MODULE_GRAVITY) * dt;
    p.renderVelocity.xyz = p.velocityLife.xyz;
    if ((flags & PARTICLE_MODULE_FLAG_SIZE) != 0u) {
        p.size.xyz = p.startSize.xyz * (ccParam(PARTICLE_MODULE_SIZE_AXES) == 0.0
            ? vec3(ccParticleCurve(PARTICLE_MODULE_SIZE))
            : vec3(ccParticleCurve(PARTICLE_MODULE_SIZE_X), ccParticleCurve(PARTICLE_MODULE_SIZE_Y), ccParticleCurve(PARTICLE_MODULE_SIZE_Z)));
    }
    if ((flags & PARTICLE_MODULE_FLAG_COLOR) != 0u) {
        vec4 color = ccColor(
            PARTICLE_MODULE_COLOR,
            t,
            ccParticlePseudoRandom(seed + PARTICLE_COLOR_RANDOM_SEED_OFFSET),
            ccParticleRandomPair(seed ^ tickId ^ p.identity.y)
        );
        p.color = ccByteColor(p.startColor * color);
    }
    if ((flags & PARTICLE_MODULE_FLAG_FORCE) != 0u) {
        vec3 force = vec3(ccParticleCurve(PARTICLE_MODULE_FORCE_X), ccParticleCurve(PARTICLE_MODULE_FORCE_Y), ccParticleCurve(PARTICLE_MODULE_FORCE_Z));
        p.velocityLife.xyz += ccRotateVector(ccParam4(PARTICLE_MODULE_FORCE_ROTATION), force) * dt;
        p.renderVelocity.xyz = p.velocityLife.xyz;
    }
    if ((flags & PARTICLE_MODULE_FLAG_VELOCITY) != 0u) {
        vec3 animated = vec3(ccParticleCurve(PARTICLE_MODULE_VELOCITY_X), ccParticleCurve(PARTICLE_MODULE_VELOCITY_Y), ccParticleCurve(PARTICLE_MODULE_VELOCITY_Z));
        p.renderVelocity.xyz = (p.velocityLife.xyz + ccRotateVector(ccParam4(PARTICLE_MODULE_VELOCITY_ROTATION), animated)) * ccParticleCurve(PARTICLE_MODULE_SPEED);
    }
    if ((flags & PARTICLE_MODULE_FLAG_LIMIT) != 0u) {
        float dampen = ccParam(PARTICLE_MODULE_DAMPEN);
        if (ccParam(PARTICLE_MODULE_LIMIT_AXES) != 0.0) {
            vec3 limitValue = ccRotateVector(
                ccParam4(PARTICLE_MODULE_LIMIT_ROTATION),
                vec3(ccParticleCurve(PARTICLE_MODULE_LIMIT_X), ccParticleCurve(PARTICLE_MODULE_LIMIT_Y), ccParticleCurve(PARTICLE_MODULE_LIMIT_Z))
            );
            p.renderVelocity.xyz = vec3(
                ccDampen(p.renderVelocity.x, limitValue.x, dampen),
                ccDampen(p.renderVelocity.y, limitValue.y, dampen),
                ccDampen(p.renderVelocity.z, limitValue.z, dampen)
            );
        } else {
            float speed = length(p.renderVelocity.xyz);
            if (speed > 0.0) {
                p.renderVelocity.xyz = p.renderVelocity.xyz / speed * ccDampen(speed, ccParticleCurve(PARTICLE_MODULE_LIMIT), dampen);
            }
        }
        p.velocityLife.xyz = p.renderVelocity.xyz;
    }
    if ((flags & PARTICLE_MODULE_FLAG_ROTATION) != 0u) {
        // CPU defers startRotated until the first animate call. Render mode may
        // have changed since birth while Rotation was disabled; rotation.xyz is
        // still the original (possibly Shape-aligned) start Euler at this point.
        if ((p.identity.w & 1u) == 0u) {
            vec3 initialEuler = p.rotation.xyz;
            if (renderMode == PARTICLE_RENDER_MODE_STRETCHED_BILLBOARD) {
                initialEuler = vec3(0.0);
            } else if (renderMode == PARTICLE_RENDER_MODE_HORIZONTAL_BILLBOARD || renderMode == PARTICLE_RENDER_MODE_VERTICAL_BILLBOARD) {
                initialEuler.xy = vec2(0.0);
            }
            p.startRotation = ccQuaternionFromEuler(initialEuler);
            p.identity.w |= 1u;
        }
        vec3 angles = vec3(0.0, 0.0, ccParticleCurve(PARTICLE_MODULE_ROTATION_Z));
        if (ccParam(PARTICLE_MODULE_ROTATION_AXES) != 0.0
            && renderMode != PARTICLE_RENDER_MODE_HORIZONTAL_BILLBOARD && renderMode != PARTICLE_RENDER_MODE_VERTICAL_BILLBOARD) {
            angles.xy = vec2(ccParticleCurve(PARTICLE_MODULE_ROTATION_X), ccParticleCurve(PARTICLE_MODULE_ROTATION_Y));
        }
        p.deltaRotation = normalize(ccQuaternionMultiply(p.deltaRotation, ccQuaternionFromEuler(angles * dt)));
        vec4 q = normalize(ccQuaternionMultiply(p.startRotation, p.deltaRotation));
        if (renderMode == PARTICLE_RENDER_MODE_STRETCHED_BILLBOARD) {
            q = vec4(0.0, 0.0, 0.0, 1.0);
        }
        p.rotation.xyz = q.xyz;
        if (q.w < 0.0) {
            p.rotation.x += 10.0;
        }
    }
    if ((flags & PARTICLE_MODULE_FLAG_TEXTURE) != 0u) {
        float startFrame = ccParticleCurve(PARTICLE_MODULE_START_FRAME) / (ccParam(PARTICLE_MODULE_TILES_X) * ccParam(PARTICLE_MODULE_TILES_Y));
        float f = fract(ccParam(PARTICLE_MODULE_CYCLES) * (ccParticleCurve(PARTICLE_MODULE_FRAME) + startFrame));
        if (ccParam(PARTICLE_MODULE_ANIMATION) == 1.0) {
            f = ((ccParam(PARTICLE_MODULE_RANDOM_ROW) != 0.0 ? p.startSize.w : ccParam(PARTICLE_MODULE_ROW)) + f) / ccParam(PARTICLE_MODULE_TILES_Y);
        }
        p.renderVelocity.w = f;
    }
#if CC_PARTICLE_HAS_NOISE
    if ((flags & PARTICLE_MODULE_FLAG_NOISE) != 0u) {
        uint permBase = uint(ccParam(PARTICLE_MODULE_NOISE_PERM));
        uint key = ccParticleHash(seed ^ ccParticleHash(p.identity.y) ^ ccParticleHash(tickId));
        vec3 point = p.positionLife.xyz + vec3(ccParticleRandom(key), ccParticleRandom(key + 1u), ccParticleRandom(key + 2u));
        vec3 speed = ccParam3(PARTICLE_MODULE_NOISE_SPEED) * systemTime;
        uint axisCount = permBase > 0u ? 3u : 0u;
        vec3 noise = vec3(0.0);
        for (uint axis = 0u; axis < axisCount; ++axis) {
            vec3 samplePoint = axis == 0u
                ? vec3(point.z + speed.x, point.y, point.x)
                : (axis == 1u
                    ? vec3(point.x + 1000.0, point.z + speed.y, point.y)
                    : vec3(point.y, point.x + 1000.0, point.z + speed.z));
            float n = ccOctaveNoise(permBase, samplePoint);
            if (axis == 0u) {
                noise.x = n;
            } else if (axis == 1u) {
                noise.y = n;
            } else {
                noise.z = n;
            }
        }
        noise *= ccParam3(PARTICLE_MODULE_NOISE_STRENGTH);
        // CPU remapX/Y/Z are stored but not used by ParticleNoise.getNoiseParticle.
        noise *= vec3(ccParticleRandom(key + 3u), ccParticleRandom(key + 4u), ccParticleRandom(key + 5u));
        p.positionLife.xyz += noise * dt;
    }
#endif
}
