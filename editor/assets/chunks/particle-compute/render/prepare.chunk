precision highp float;
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
#include <particle-compute/common/dispatch>

#include <particle-compute/common/state>

#pragma rate RenderParams pass
layout(std140) uniform RenderParams {
    uvec4 renderInfo;
};
#pragma rate SimulationState pass
layout(std430) readonly buffer SimulationState {
    ParticleState particles[];
};
#pragma rate SimulationCounters pass
layout(std430) readonly buffer SimulationCounters {
    uint counters[];
};
#pragma rate InstanceVertices pass
layout(std430) buffer InstanceVertices {
    uint vertices[];
};
#pragma rate IndirectArguments pass
layout(std430) buffer IndirectArguments {
    uint arguments[];
};
void main() {
    uint i = ccParticleInvocationIndex();
    uint count = min(counters[0], renderInfo.x);
    if (i == 0u) {
        arguments[0] = renderInfo.y; // indexCount
        arguments[1] = count;
        arguments[2] = 0u; // firstIndex
        arguments[3] = 0u; // baseVertex (signed i32 bits)
        arguments[4] = 0u; // firstInstance
    }
    if (i >= count) return;
    ParticleState p = particles[i];
    uint base = i * renderInfo.z;
    vertices[base + 0u] = floatBitsToUint(p.positionLife.x);
    vertices[base + 1u] = floatBitsToUint(p.positionLife.y);
    vertices[base + 2u] = floatBitsToUint(p.positionLife.z);
    vertices[base + 3u] = floatBitsToUint(renderInfo.w != 0u ? p.renderVelocity.w : 0.0);
    vertices[base + 4u] = floatBitsToUint(p.size.x);
    vertices[base + 5u] = floatBitsToUint(p.size.y);
    vertices[base + 6u] = floatBitsToUint(p.size.z);
    vertices[base + 7u] = floatBitsToUint(p.rotation.x);
    vertices[base + 8u] = floatBitsToUint(p.rotation.y);
    vertices[base + 9u] = floatBitsToUint(p.rotation.z);
    // State colors are quantized normalized bytes. roundEven avoids losing a
    // byte to f32 division/multiplication error, and matches Uint8ClampedArray.
    uvec4 c = uvec4(roundEven(clamp(p.color, 0.0, 1.0) * 255.0));
    vertices[base + 10u] = c.x | (c.y << 8u) | (c.z << 16u) | (c.w << 24u);
    if (renderInfo.z == 14u) {
        vertices[base + 11u] = floatBitsToUint(p.renderVelocity.x);
        vertices[base + 12u] = floatBitsToUint(p.renderVelocity.y);
        vertices[base + 13u] = floatBitsToUint(p.renderVelocity.z);
    }
}
